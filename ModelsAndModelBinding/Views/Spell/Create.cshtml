@model ModelsAndModelBinding.Models.Spell

@{
    //Give title to the webpage on the Layout page.
    ViewData["Title"] = "Inscribe Spell";
}

<h1>Inscribe New Spell</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Level" class="form-label"></label>
                <input asp-for="Level" class="form-control" />
                <span asp-validation-for="Level" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Rarity" class="form-label"></label>
                <input asp-for="Rarity" class="form-control" />
                <span asp-validation-for="Rarity" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Inscribe Spell</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Back to Grimoire</a>
        </form>
    </div>
</div>
