@{
    ViewData["Title"] = "Grimoire Data & Privacy Policy";
}

<h1>@ViewData["Title"]</h1>
<p class="text-muted">Last updated: August 2026</p>
<hr />

<div class="row mt-4">
    <div class="col-md-8">
        <div class="card mb-3 shadow-sm">
            <div class="card-body">
                <h5 class="card-title text-primary">1. Arcane Spell Inscription Data</h5>
                <p class="card-text">
                    All magic data, spell names, schools of magic, levels, and rarity tiers submitted through this portal are bound strictly to your local session and the grimoire database.
                </p>
            </div>
        </div>

        <div class="card mb-3 shadow-sm">
            <div class="card-body">
                <h5 class="card-title text-primary">2. Model Binding Security</h5>
                <p class="card-text">
                    Inscribed spells undergo strict server-side validation using Data Annotations to ensure no corrupted or malicious incantations breach the repository.
                </p>
            </div>
        </div>

        <div class="card mb-3 shadow-sm">
            <div class="card-body">
                <h5 class="card-title text-primary">3. Third-Party Access</h5>
                <p class="card-text">
                    Your inscribed spells will never be shared with outside rival guilds, archmages, or external third-party tracking services without explicit consent.
                </p>
            </div>
        </div>

        <a asp-action="Index" class="btn btn-outline-secondary mt-2">Return to Home</a>
    </div>
</div>